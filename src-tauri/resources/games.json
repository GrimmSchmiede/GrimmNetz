{
  "games": [
    {
      "id": "minecraft-paper",
      "name": "Minecraft",
      "subtitle": "Paper (aktuellste Version)",
      "icon": "minecraft.png",
      "requires": [],
      "tested_on": [],
      "install": {
        "type": "docker",
        "image": "itzg/minecraft-server:latest",
        "docker_env": {
          "EULA": "TRUE",
          "TYPE": "PAPER",
          "MEMORY": "4096M"
        },
        "pre_start_steps": []
      },
      "start_command": "",
      "default_cpu_limit_percent": 200,
      "default_ram_limit_mb": 4096,
      "config": {
        "file": "server.properties",
        "format": "properties",
        "fields": [
          { "key": "motd", "label": "Server Name (MOTD)", "type": "text", "default": "A Minecraft Server" },
          {
            "key": "gamemode",
            "label": "Spielmodus",
            "type": "select",
            "default": "survival",
            "options": [
              { "value": "survival", "label": "Überleben" },
              { "value": "creative", "label": "Kreativ" },
              { "value": "adventure", "label": "Abenteuer" },
              { "value": "spectator", "label": "Zuschauer" }
            ]
          },
          {
            "key": "difficulty",
            "label": "Schwierigkeitsgrad",
            "type": "select",
            "default": "easy",
            "options": [
              { "value": "peaceful", "label": "Friedlich" },
              { "value": "easy", "label": "Leicht" },
              { "value": "normal", "label": "Normal" },
              { "value": "hard", "label": "Hart" }
            ]
          },
          { "key": "max-players", "label": "Maximale Spieleranzahl", "type": "number", "default": "20" },
          { "key": "server-port", "label": "Port", "type": "number", "default": "25565", "opens_port_protocol": "tcp" },
          { "key": "white-list", "label": "White-List aktivieren", "type": "bool", "default": "false" },
          { "key": "pvp", "label": "PvP aktivieren", "type": "bool", "default": "true" },
          { "key": "view-distance", "label": "Sichtweite (Chunks)", "type": "number", "default": "10" },
          { "key": "online-mode", "label": "Online-Mode (Authentifizierung)", "type": "bool", "default": "true" },
          { "key": "hardcore", "label": "Hardcore-Modus", "type": "bool", "default": "false" },
          { "key": "spawn-protection", "label": "Spawn-Schutz (Radius in Blöcken)", "type": "number", "default": "16" },
          { "key": "allow-flight", "label": "Fliegen erlauben", "type": "bool", "default": "false" }
        ]
      },
      "ports": [{ "port": 25565, "protocol": "tcp" }]
    },
    {
      "id": "palworld",
      "name": "Palworld",
      "subtitle": "v0.2.1.0",
      "icon": "palworld.png",
      "requires": ["steamcmd"],
      "tested_on": [],
      "install": {
        "type": "steamcmd",
        "app_id": 2394010,
        "steps": [
          "mkdir -p /home/gameserver/instances/{instance_id}",
          "/home/gameserver/.steamcmd/steamcmd.sh +force_install_dir /home/gameserver/instances/{instance_id} +login anonymous +app_update 2394010 validate +quit"
        ]
      },
      "start_command": "./PalServer.sh -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS",
      "default_cpu_limit_percent": 200,
      "default_ram_limit_mb": 8192,
      "config": {
        "file": "Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
        "format": "palworld-ini",
        "fields": [
          { "key": "ServerName", "label": "Server Name", "type": "text", "default": "GrimmNetz Palworld" },
          { "key": "ServerPassword", "label": "Server Passwort", "type": "password", "default": "" },
          { "key": "DayTimeSpeedRate", "label": "Geschwindigkeit Tag", "type": "number", "default": "1.000000" },
          { "key": "NightTimeSpeedRate", "label": "Geschwindigkeit Nacht", "type": "number", "default": "1.000000" },
          { "key": "ExpRate", "label": "Erfahrungspunkte-Multiplikator", "type": "number", "default": "1.000000" },
          { "key": "PalCaptureRate", "label": "Fangchance Pals", "type": "number", "default": "1.000000" },
          { "key": "PalSpawnNumRate", "label": "Pal-Spawnrate", "type": "number", "default": "1.000000" },
          { "key": "PlayerDamageRateAttack", "label": "Spieler-Schaden austeilen", "type": "number", "default": "1.000000" },
          { "key": "PalDamageRateAttack", "label": "Pal-Schaden austeilen", "type": "number", "default": "1.000000" },
          { "key": "DropItemMaxNum", "label": "Maximale liegende Items", "type": "number", "default": "3000" },
          { "key": "CollectionDropRate", "label": "Ressourcen-Multiplikator", "type": "number", "default": "1.000000" },
          {
            "key": "DeathPenalty",
            "label": "Todesstrafe",
            "type": "select",
            "default": "All",
            "options": [
              { "value": "None", "label": "Nichts verlieren" },
              { "value": "Item", "label": "Nur Items" },
              { "value": "ItemAndEquipment", "label": "Items und Pals" },
              { "value": "All", "label": "Alles verlieren" }
            ]
          },
          { "key": "GuildPlayerMaxNum", "label": "Maximale Gildengröße", "type": "number", "default": "20" }
        ]
      },
      "ports": [{ "port": 8211, "protocol": "udp" }]
    },
    {
      "id": "7dtd",
      "name": "7 Days to Die",
      "subtitle": "Dedicated Server",
      "icon": "7daystodie.png",
      "requires": ["steamcmd"],
      "tested_on": ["Ubuntu 24.04"],
      "install": {
        "type": "steamcmd",
        "app_id": 294420,
        "steps": [
          "mkdir -p /home/gameserver/instances/{instance_id}",
          "/home/gameserver/.steamcmd/steamcmd.sh +force_install_dir /home/gameserver/instances/{instance_id} +login anonymous +app_update 294420 validate +quit"
        ]
      },
      "start_command": "./7DaysToDieServer.x86_64 -logfile /home/gameserver/instances/{instance_id}/7dtd.log -batchmode -nographics -dedicated -configfile=serverconfig.xml",
      "default_cpu_limit_percent": 200,
      "default_ram_limit_mb": 6144,
      "config": {
        "file": "serverconfig.xml",
        "format": "xml-properties",
        "fields": [
          { "key": "ServerName", "label": "Server Name", "type": "text", "default": "My Game Host" },
          { "key": "ServerPort", "label": "Port", "type": "number", "default": "26900", "opens_port_protocol": "tcp" },
          {
            "key": "GameMode",
            "label": "Spielmodus",
            "type": "select",
            "default": "GameModeSurvival",
            "options": [
              { "value": "GameModeSurvival", "label": "Survival" },
              { "value": "GameModeCreative", "label": "Creative" }
            ]
          },
          { "key": "MaxSpawnedZombies", "label": "Maximale Zombies gleichzeitig", "type": "number", "default": "64" },
          { "key": "LandClaimSize", "label": "Landanspruch-Größe (Blöcke)", "type": "number", "default": "41" },
          { "key": "ServerMaxPlayerCount", "label": "Maximale Spieleranzahl", "type": "number", "default": "8" },
          {
            "key": "SandboxCode",
            "label": "Sandbox-Code (Schwierigkeit, XP, Loot, Blutmond, ...)",
            "type": "text",
            "default": "",
            "hint": "Seit Version 1.0+ steckt die komplette Gameplay-Balance (Schwierigkeit, XP, Beute, Blutmond) in diesem einen Code statt in Einzelwerten. Erzeugen: lokal 7 Days to Die starten, 'Neues Spiel' -> Sandbox-Optionen nach Wunsch einstellen -> generierten Code hier einfügen."
          }
        ]
      },
      "ports": [
        { "port": 26900, "protocol": "tcp" },
        { "port": 26900, "protocol": "udp" }
      ]
    },
    {
      "id": "dayz",
      "name": "DayZ",
      "subtitle": "Dedicated Server",
      "icon": "dayz.png",
      "requires": ["steamcmd"],
      "tested_on": [],
      "install": {
        "type": "steamcmd",
        "app_id": 223350,
        "steps": [
          "mkdir -p /home/gameserver/instances/{instance_id}",
          "/home/gameserver/.steamcmd/steamcmd.sh +force_install_dir /home/gameserver/instances/{instance_id} +login anonymous +app_update 223350 validate +quit"
        ]
      },
      "start_command": "./DayZServer -config=serverDZ.cfg -port=2302",
      "default_cpu_limit_percent": 200,
      "default_ram_limit_mb": 8192,
      "ports": [{ "port": 2302, "protocol": "udp" }]
    },
    {
      "id": "factorio",
      "name": "Factorio",
      "subtitle": "Headless Server",
      "icon": "factorio.png",
      "console_say_format": "{message}",
      "requires": [],
      "tested_on": [],
      "install": {
        "type": "docker",
        "image": "factoriotools/factorio:latest",
        "container_mount": "/factorio",
        "docker_env": {
          "RCON_PORT": "27015"
        },
        "pre_start_steps": [
          "mkdir -p /home/gameserver/instances/{instance_id}/config",
          "echo '{\"name\":\"GrimmNetz Factorio\",\"description\":\"\",\"tags\":[],\"max_players\":0,\"visibility\":{\"public\":false,\"lan\":true},\"username\":\"\",\"password\":\"\",\"token\":\"\",\"game_password\":\"\",\"require_user_verification\":true,\"max_upload_in_kilobytes_per_second\":0,\"max_upload_slots\":5,\"minimum_latency_in_ticks\":0,\"ignore_player_limit_for_returning_players\":false,\"allow_commands\":\"admins-only\",\"autosave_interval\":10,\"autosave_slots\":5,\"afk_autokick_interval\":0,\"auto_pause\":true,\"only_admins_can_pause_the_game\":true,\"autosave_only_on_server\":true}' > /home/gameserver/instances/{instance_id}/config/server-settings.json",
          "openssl rand -hex 16 > /home/gameserver/instances/{instance_id}/config/rconpw && chmod 600 /home/gameserver/instances/{instance_id}/config/rconpw",
          "echo '{}' > /home/gameserver/instances/{instance_id}/config/map-settings.json",
          "echo '{}' > /home/gameserver/instances/{instance_id}/config/map-gen-settings.json"
        ]
      },
      "start_command": "",
      "rcon": { "port": 27015, "password_file": "config/rconpw", "broadcast_command": "{message}", "save_command": "server-save" },
      "config": {
        "file": "config/server-settings.json",
        "format": "json",
        "fields": [
          { "key": "name", "label": "Server Name", "type": "text", "default": "GrimmNetz Factorio" },
          { "key": "max_players", "label": "Spieler Slots (0 = unbegrenzt)", "type": "number", "default": "0" },
          { "key": "game_password", "label": "Passwort", "type": "password", "default": "" }
        ]
      },
      "default_cpu_limit_percent": 150,
      "default_ram_limit_mb": 2048,
      "ports": [{ "port": 34197, "protocol": "udp" }]
    },
